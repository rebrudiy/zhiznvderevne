{
  "title": "ZhiznVDerevne",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests/sec",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(rate(blog_http_requests_total[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency (s)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(blog_http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Generated Posts",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(increase(blog_generated_posts_total[1h]))",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Generation Errors",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum(increase(blog_generation_errors_total[1h]))",
          "refId": "D"
        }
      ]
    }
  ]
}
